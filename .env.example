SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/school_erp
SPRING_DATASOURCE_USERNAME=school_erp
SPRING_DATASOURCE_PASSWORD=school_erp
JWT_ISSUER=school-erp
JWT_AUDIENCES=school-erp-api
JWT_SECRET=replace-with-at-least-32-bytes-of-random-secret
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
JWT_PASSWORD_RESET_TOKEN_TTL=30m
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCK_DURATION=15m
BOOTSTRAP_SUPER_ADMIN_ENABLED=false
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.edu
BOOTSTRAP_SUPER_ADMIN_PASSWORD=replace-with-strong-password
BOOTSTRAP_SUPER_ADMIN_FIRST_NAME=Super
BOOTSTRAP_SUPER_ADMIN_LAST_NAME=Admin
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
